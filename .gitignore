ml-service/artifacts/disease/*.h5
ml-service/artifacts/disease/*.keras

# Backups written by the training scripts when they overwrite a model
*.pkl.bak

# Scratch
tools/_*.py

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
