# =============================================================================
# Krishi.AI configuration
#
# Copy to .env and fill in. Never commit the filled-in file.
#   cp .env.example .env
#
# Both services read this same file. Every value below has a working default
# except JWT_SECRET in production, so a local run needs almost nothing set.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# "development" or "production". In production the interactive API docs are
# switched off and JWT_SECRET becomes mandatory.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backend HTTP
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Browser origins allowed to call the API, comma-separated. Leave EMPTY when the
# backend serves the bundled frontend (the default) - it is then same-origin and
# needs no CORS entry. Only set this if you host the frontend on another domain.
# Never use "*": the API is token-authenticated.
# Example: CORS_ORIGINS=https://krishi.example.com,https://www.krishi.example.com
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite by default so a fresh clone runs with no external services.
# For production use PostgreSQL, e.g.
#   DATABASE_URL=postgresql+psycopg://krishi:CHANGE_ME@localhost:5432/krishi
# (uncomment psycopg in backend/requirements.txt first)
DATABASE_URL=sqlite:///./krishi.db

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. The app refuses to start without it when
# ENVIRONMENT=production. In development a random key is generated per process,
# which means restarting invalidates existing sign-ins.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

JWT_ALGORITHM=HS256
# How long a sign-in lasts. Farmers use this on shared and low-end phones, so
# the default is generous; shorten it if that is not acceptable for you.
ACCESS_TOKEN_DAYS=30

# -----------------------------------------------------------------------------
# ML service
# -----------------------------------------------------------------------------
# Where the backend reaches the ML service. Keep it on a private network or
# localhost - it has no authentication of its own by design.
ML_SERVICE_URL=http://127.0.0.1:8100

ML_TIMEOUT_SECONDS=30
# Image inference is much slower than the tabular models.
ML_UPLOAD_TIMEOUT_SECONDS=90
# Largest photo the backend will accept, in bytes (8 MB).
MAX_UPLOAD_BYTES=8388608

# -----------------------------------------------------------------------------
# Market prices (data.gov.in / Agmarknet)
# -----------------------------------------------------------------------------
# Free key from https://data.gov.in/apis (register, then copy your API key).
# Do NOT use the sample key from their docs - it is shared, heavily rate-limited,
# and truncates every response to 10 rows whatever limit you ask for.
# Without it the Market page reports itself unavailable and everything else in
# Krishi.AI carries on working. Prices shown are the government's own reported
# mandi figures - never estimated or filled in.
DATA_GOV_API_KEY=

# The "Current Daily Price of Various Commodities from Various Markets (Mandi)"
# resource. Change only if data.gov.in reissues it under a new id.
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# -----------------------------------------------------------------------------
# AI assistant (Google Gemini)
# -----------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Without it the chatbot still serves curated FAQ answers and says plainly that
# the AI is not configured. It never fabricates a reply.
# This key is used server-side only and is never sent to the browser.
GEMINI_API_KEY=

# Pin a model your key actually has access to. List yours with:
#   python -c "from google import genai; #     print([m.name for m in genai.Client(api_key='KEY').models.list()])"
# The "gemini-flash-latest" alias also exists, but an alias can start pointing
# at a slower or overloaded model without warning, so a pinned name is safer.
GEMINI_MODEL=gemini-2.5-flash

# How many previous turns of a conversation are sent as context.
CHAT_HISTORY_TURNS=10
# Longest question accepted, in characters.
CHAT_MAX_CHARS=2000

# =============================================================================
# ML service only (read by ml-service/app/config.py)
# =============================================================================

# Where the model files live. Defaults to ml-service/artifacts.
# ML_ARTIFACT_DIR=/srv/krishi/artifacts

# The trained plant-disease Keras model (~245 MB). NOT committed to this
# repository - see docs/plant-disease-model.md for where to get it. Without it
# the disease endpoint reports 503 and the rest of Krishi.AI carries on working.
# Leave unset to auto-detect artifacts/disease/plant_disease_prediction.{keras,h5}.
# DISEASE_MODEL_PATH=/srv/krishi/artifacts/disease/plant_disease_prediction.keras

# Largest image the ML service will decode, in bytes.
ML_MAX_IMAGE_BYTES=8388608

# Predictions below this probability are flagged to the user as unreliable.
ML_LOW_CONFIDENCE=0.55

# Browser origins allowed to call the ML service directly. Leave empty in normal
# operation - only the backend should talk to it.
ML_CORS_ORIGINS=
